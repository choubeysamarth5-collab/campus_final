# =============================================
# .gitignore – Files to NOT upload to GitHub
# =============================================

# Environment variables (contains passwords!)
.env
backend/.env

# Node.js dependencies (too big to upload)
node_modules/
backend/node_modules/

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Build outputs
dist/
build/
