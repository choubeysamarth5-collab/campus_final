# =============================================
# .env – Environment Variables for CampusBot
# IMPORTANT: Never commit this file to GitHub!
# Add .env to your .gitignore file
# =============================================

# MongoDB Connection String
# Option 1: Local MongoDB (default)
MONGO_URI=mongodb://localhost:27017/campusbot

# Option 2: MongoDB Atlas (cloud, free tier available)
# MONGO_URI=mongodb+srv://yourUsername:yourPassword@cluster0.xxxxx.mongodb.net/campusbot

# Server Port (default: 5000)
PORT=5000

# Environment (development or production)
NODE_ENV=development
